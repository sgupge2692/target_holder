# DB
DB_USER=stock_user
DB_PASSWORD=your_password_here
DB_NAME=stock_db

# API Keys
JQUANTS_API_KEY=your_jquants_key
OPENAI_API_KEY=your_openai_key
STRIPE_SECRET_KEY=your_stripe_key
STRIPE_WEBHOOK_SECRET=your_webhook_secret
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxxxxxx  # Stripe ダッシュボードの Price ID

# Auth
JWT_SECRET=your_jwt_secret_here

# ENV
ENV=development
NEXT_PUBLIC_SITE_URL=https://stock-intelligence.app  # 本番ドメイン
CORS_ORIGINS=http://localhost:3000,https://stock-intelligence.app  # カンマ区切りで複数指定可

# Feature flags
NEWS_SENTIMENT=false          # true にするとニュースセンチメント特徴量を有効化
NEWS_USE_LLM=false            # true にすると gpt-4o-mini でセンチメント分析（OPENAI_API_KEY 必要）

# メール通知 (EMAIL_PROVIDER=smtp or sendgrid)
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@stock-intelligence.app
EMAIL_FROM_NAME=Stock Intelligence
# SMTP (Gmail など)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password   # Gmail の場合はアプリパスワードを発行
# SendGrid (EMAIL_PROVIDER=sendgrid の場合)
SENDGRID_API_KEY=SG.xxxxxx

# Twitter/X 自動投稿 (scripts/post_twitter.py)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# エラー監視 (Sentry)
SENTRY_DSN=                          # backend 用 DSN
NEXT_PUBLIC_SENTRY_DSN=              # frontend 用 DSN (同じDSNで可)
NEXT_PUBLIC_RELEASE=0.3.0            # バージョン (git tag と合わせると便利)

# 管理者メールアドレス (カンマ区切りで複数指定可)
ADMIN_EMAILS=admin@example.com

# Redis (レート制限・キャッシュ)
REDIS_URL=redis://redis:6379/0

# =====================================================================
# Stock Intelligence — 環境変数テンプレート
# このファイルをコピーして .env を作成してください
#   cp .env.example .env
# =====================================================================

# ── 環境 ─────────────────────────────────────────────────────────────
ENV=development         # development | production

# ── データベース (Supabase / PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://stock:stock@localhost:5432/stockdb
# Supabase の場合:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# ── Redis (Upstash / ローカル) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Upstash の場合:
# REDIS_URL=rediss://default:[TOKEN]@[HOST]:6379

# ── 認証 ─────────────────────────────────────────────────────────────
# 本番では必ず変更! 32文字以上のランダム文字列
# 生成コマンド: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production

# ── フロントエンドURL ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# 本番:
# FRONTEND_URL=https://your-app.vercel.app

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
# 本番 (カンマ区切りで複数指定可):
# CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...

# ── OpenAI ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── J-Quants (株価データ) ─────────────────────────────────────────────
JQUANTS_MAIL_ADDRESS=your@email.com
JQUANTS_PASSWORD=your-password

# ── メール送信 ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
# または SendGrid:
# SENDGRID_API_KEY=SG...

# ── 管理者 ───────────────────────────────────────────────────────────
# カンマ区切りで管理者メールアドレスを指定
ADMIN_EMAILS=your@email.com

# ── Sentry (任意) ────────────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...

# ── Prometheus (任意) ────────────────────────────────────────────────
# METRICS_TOKEN=your-secret-token
# PROMETHEUS_PUSH_GATEWAY=http://pushgateway:9091

# ── DB コネクションプール (任意) ──────────────────────────────────────
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
